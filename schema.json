{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MagicDash plugin catalog",
  "type": "object",
  "required": ["plugins"],
  "properties": {
    "name": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "author", "repo", "version", "download", "sha256", "sdkVersion"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": { "type": "string", "minLength": 1, "maxLength": 300 },
          "author": { "type": "string" },
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "download": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sdkVersion": { "type": "integer", "minimum": 1 },
          "minHost": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
          "screenshot": { "type": "string", "pattern": "^https://" },
          "reviewed": { "type": "boolean" },
          "addedAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      }
    }
  }
}
